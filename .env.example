# ==========================================
# ZOMBIE LIVE - Variáveis de Ambiente (.env)
# ==========================================
# Copie este arquivo para .env na raiz do projeto:
# cp .env.example .env

# Ambiente de Execução (development | production | test)
NODE_ENV=development

# Porta do Servidor Principal (Backend Node.js / Socket.IO)
PORT=4000
HOST=0.0.0.0

# Portas de Desenvolvimento dos Frontends
GAME_PORT=3000
ADMIN_PORT=3001

# URLs Públicas para CORS e Conexão de Clientes
CLIENT_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
VITE_SERVER_URL=http://localhost:4000

# Segurança e Autenticação Administrativa
# ATENÇÃO: Altere para uma chave secreta longa e aleatória em produção
JWT_SECRET=super_secret_zombie_live_dev_token_change_in_production
JWT_EXPIRES_IN=24h

# Credenciais Iniciais do Primeiro Administrador
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123456

# Banco de Dados (Opcional - caso omitido, utiliza armazenamento em memória de alta performance)
# Exemplo PostgreSQL: postgresql://usuario:senha@localhost:5432/zombielive
DATABASE_URL=

# Modo do Provedor de Eventos da Live (SIMULATOR | CONNECTED | DISCONNECTED)
LIVE_PROVIDER=SIMULATOR

# Configuração da Integração com TikTok LIVE (Opcional - Usado apenas quando LIVE_PROVIDER=CONNECTED)
# Nome de usuário do canal TikTok (ex: @meucanal)
TIKTOK_USERNAME=
# Tempo limite para reconexão em milissegundos
TIKTOK_RECONNECT_INTERVAL=5000
# Ativar logs detalhados do conector
TIKTOK_DEBUG=false

# Limites e Anti-Spam de Comandos
COMMAND_RATE_LIMIT_PER_USER=3
COMMAND_RATE_LIMIT_GLOBAL_PER_SEC=50
COMMAND_COOLDOWN_MS=2000
